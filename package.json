{
  "name": "odf-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency JavaScript engines for OpenDocument text, spreadsheet and presentation files",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages test/integration.test.js",
    "build": "node scripts/build.mjs",
    "check": "npm run test && npm run build && npm run smoke && node scripts/browser.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench": "node scripts/bench.mjs",
    "test:browser": "npm run build && node scripts/browser.mjs",
    "bench:browser": "npm run build && node scripts/browser.mjs --bench"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.64.1"
  }
}
